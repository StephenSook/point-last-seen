rules_version = '2';

// Point Last Seen Cloud Storage rules (spec section 7). Membership comes from the same
// custom claims as Firestore. Clips are capped at 14,000,000 bytes (sent inline to
// AI Logic; base64 must stay under the 20 MB request limit); photos at 2 MB.
// Objects under clips/, photos/ and packs/ are deleted 30 days after upload by the bucket
// lifecycle rule in storage.lifecycle.json (applied with gcloud and read back 2026-11-18).
// These rules guard signed-in reads only: a member who reads an object's metadata gets a
// download token, and that link works without signing in until the object is deleted
// (docs/LIMITS.md, Media retention).
service firebase.storage {
  match /b/{bucket}/o {

    // Claims outlive an incident, so membership also needs the incident (read from Firestore) to
    // exist and not be expired. Cross-service rules: the deploy grants Storage read access to Firestore.
    // A judge sandbox must carry a timestamp expiry in the future and have finished its setup (as in
    // firestore.rules liveFor; only an explicit setupReady == true counts); any other incident may have no expiry.
    function notExpired(incidentId) {
      let i = firestore.get(/databases/(default)/documents/incidents/$(incidentId)).data;
      let exp = i.get('expiresAt', null);
      return i.get('mode', '') == 'judge'
        ? (exp is timestamp && request.time < exp && i.get('setupReady', false) == true)
        : (exp == null || (exp is timestamp && request.time < exp));
    }
    // Ruling I9: the uploader's own clip reading, with the three required consents, exists before the upload.
    function clipReadingReady(incidentId, file) {
      let c = firestore.get(/databases/(default)/documents/incidents/$(incidentId)/clipReadings/$(file.split('[.]')[0])).data;
      // The consent must outlive the clip by a day: the lifecycle deletes the clip 30 days after upload, so its
      // expiry must be at least 31 days after this upload, whenever it was written (a creator renews it).
      return c.createdByUid == request.auth.uid
        && c.expiresAt is timestamp && c.expiresAt >= request.time + duration.value(31, 'd')
        && c.consent.personInClip != null && c.consent.footageOwner != null && c.consent.cloudProcessing != null;
    }
    // Not removed by command (functions/src/members.ts writes the record before clearing the claims).
    function isMember(incidentId) {
      return request.auth != null && request.auth.token.inc == incidentId && notExpired(incidentId)
        && !firestore.exists(/databases/(default)/documents/incidents/$(incidentId)/removed/$(request.auth.uid));
    }
    function isCommandOrFamily(incidentId) {
      return isMember(incidentId) && request.auth.token.role in ['command', 'family'];
    }

    // Media are create-only at clips/{incidentId}/{sha256}.mp4 and photos/{incidentId}/{sha256}.jpg, so a
    // reading cached under a hash can never point at replaced bytes. `resource == null` (no existing object)
    // is required too, because the emulator allowed an overwrite under the create rule alone. Rules cannot
    // hash the bytes; the reader checks the SHA-256 of what it reads against the name.
    match /clips/{incidentId}/{file} {
      allow read: if isMember(incidentId);
      allow create: if isCommandOrFamily(incidentId)
        && resource == null
        && file.matches('^[0-9a-f]{64}[.]mp4$')
        && clipReadingReady(incidentId, file)
        && request.resource.size <= 14000000
        && request.resource.contentType.matches('video/.*');
      allow delete: if isMember(incidentId) && request.auth.token.role == 'command';
    }

    match /photos/{incidentId}/{file} {
      allow read: if isCommandOrFamily(incidentId);
      allow create: if isCommandOrFamily(incidentId)
        && resource == null
        && file.matches('^[0-9a-f]{64}[.]jpg$')
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isMember(incidentId) && request.auth.token.role == 'command';
    }

    // Packs are built by the pack function only, at packs/{incidentId}/{teamId}/v{n}.bundle, and read by
    // command and by their own team only.
    match /packs/{incidentId}/{teamId}/{file} {
      allow read: if isMember(incidentId)
        && (request.auth.token.role == 'command' || request.auth.token.team == teamId);
      allow write: if false;
    }
  }
}
