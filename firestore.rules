rules_version = '2';

// Point Last Seen security rules (spec section 7). All incident data lives under
// incidents/{incidentId}. Membership comes from custom claims set by joinIncident:
// request.auth.token.inc (incident id), .role ("command", "searcher", "family"), .team.
// Events are create only; idempotence lives in the client (a re-send of an existing
// event is an update and is denied, and the client reads the first copy back).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // Claims outlive an incident, so membership also needs the incident to exist and not be expired
    // (judge sandboxes carry expiresAt). get() of the same doc is cached within one request.
    function incidentData(incidentId) {
      return get(/databases/$(database)/documents/incidents/$(incidentId)).data;
    }
    // A judge sandbox must carry a timestamp expiry in the future and have finished its setup (a returning judge's
    // claims still name the sandbox while it is rebuilt). Only an explicit setupReady == true counts as ready; a
    // sandbox with no flag is not live. Any other incident may have no expiry.
    function liveFor(i) {
      let exp = i.get('expiresAt', null);
      return i.get('mode', '') == 'judge'
        ? (exp is timestamp && request.time < exp && i.get('setupReady', false) == true)
        : (exp == null || (exp is timestamp && request.time < exp));
    }
    function notExpired(incidentId) {
      return liveFor(incidentData(incidentId));
    }
    function isMember(incidentId) {
      return signedIn() && request.auth.token.inc == incidentId && notExpired(incidentId) && !isRemoved(incidentId);
    }
    // Command removed this account (removeMember writes the record before clearing the claims, so a token that still
    // carries them is refused at once, not only after it expires).
    function isRemoved(incidentId) {
      return exists(/databases/$(database)/documents/incidents/$(incidentId)/removed/$(request.auth.uid));
    }
    // A closed incident stays readable to its members but takes no new events or plans.
    function isOpen(incidentId) {
      return incidentData(incidentId).status != 'closed';
    }
    function role() {
      return request.auth.token.role;
    }
    function isCommand(incidentId) {
      return isMember(incidentId) && role() == 'command';
    }
    function isFamily(incidentId) {
      return isMember(incidentId) && role() == 'family';
    }
    function isCommandOrFamily(incidentId) {
      return isCommand(incidentId) || isFamily(incidentId);
    }

    // Join code hashes: admin only. A hash of a short code in a member-readable doc could be
    // brute-forced offline, so no client may read or write these.
    match /joinCodes/{codeHash} {
      allow read, write: if false;
    }

    // ops/storage holds only the bucket's lifecycle state and the sweep time, written by the scheduled
    // deleteIncidentMedia; the daily probe reads it without credentials. No other ops doc is readable.
    match /ops/{docId} {
      allow read: if docId == 'storage';
      allow write: if false;
    }

    match /incidents/{incidentId} {
      allow read: if isMember(incidentId);
      // Incidents are created by admin tools only. Command may edit an open incident, but mode,
      // expiresAt and closedAt are server-owned (a sandbox cannot be extended, a drill's retention cannot be moved)
      // and closing is final.
      allow create: if false;
      allow update: if isCommand(incidentId)
        && resource.data.get('status', 'open') != 'closed'
        && request.resource.data.status in ['open', 'found', 'closed']
        // What the family may be told about the search: only that teams are searching or that it is paused.
        && (!('searchState' in request.resource.data) || request.resource.data.searchState in ['searching', 'paused'])
        && (!('conditions' in request.resource.data) || schema_IncidentConditions(request.resource.data.conditions))
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['mode', 'expiresAt', 'joinCodeHash', 'commandJoinCodeHash', 'mediaDeletedAt', 'mediaSweepEmpty', 'mediaRevokedAt',
                'setupReady', 'setupId', 'setupStartedAtMs', 'closedAt'])
        // The prior moves one version at a time, and its inputs change only with that step, so two seats
        // rebuilding from the same version cannot both land.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['priorVersion', 'priorInputEventIds', 'ipp',
              'ippSource', 'priorLayers', 'terrain', 'priorModel', 'priorSeed', 'engineParams', 'priorBuiltAt'])
            || request.resource.data.priorVersion == resource.data.get('priorVersion', 0) + 1)
        // When the current prior was built, for the replay: the server's time of the write that built it.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['priorBuiltAt'])
            || request.resource.data.priorBuiltAt == request.time);
      allow delete: if false;

      match /segments/{segmentId} {
        // A segment's prior changes only in the batch that moves the incident to the next version, and takes
        // that version: a rebuild from an older version cannot overwrite a newer one.
        function priorMovesWithIncident() {
          let incident = /databases/$(database)/documents/incidents/$(incidentId);
          let changed = request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys();
          return !changed.hasAny(['priorPoa', 'priorVersion'])
            || (request.resource.data.priorVersion == getAfter(incident).data.get('priorVersion', -1)
                && getAfter(incident).data.get('priorVersion', -1) == get(incident).data.get('priorVersion', 0) + 1);
        }
        allow read: if isMember(incidentId);
        allow create, update: if isCommand(incidentId) && priorMovesWithIncident();
        allow delete: if isCommand(incidentId);
      }

      // A segment debrief: how long the clear took and what worked or did not. Command writes any; a member writes
      // only for a segment they cleared, pointing at their own cleared event. Command alone edits; nobody deletes
      // (incident cleanup does). The engine never reads it.
      // A member flags shared content as a problem (App Review guideline 1.2): a searcher or family member files its
      // own, once, with the server's time; command reads every report, the author only its own; nobody updates or
      // deletes one. The target id fits the target: an event id for an event, a plan id for the task, none for the
      // family's description.
      match /contentReports/{reportId} {
        allow create: if isMember(incidentId) && role() in ['searcher', 'family']
          && reportId.matches('^[0-9a-f]{32}$')
          && schema_ContentReport(request.resource.data)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.role == role()
          && (request.resource.data.target == 'family_description') == (request.resource.data.targetId == null)
          && (request.resource.data.target != 'event' || request.resource.data.targetId.matches('^[0-9a-f]{32}$'));
        allow read: if isCommand(incidentId) || (isMember(incidentId) && resource.data.authorUid == request.auth.uid);
        allow update, delete: if false;
      }

      match /debriefs/{segmentId} {
        function debriefOk(d) {
          return d.keys().hasOnly(['tookMinutes', 'worked', 'didNotWork', 'coverageStatedPct', 'clues', 'hazards', 'byUid',
              'createdAt', 'clearedEventId'])
            && d.keys().hasAll(['tookMinutes', 'byUid', 'createdAt'])
            && d.tookMinutes is int && d.tookMinutes >= 0 && d.tookMinutes <= 1440
            && (!('worked' in d) || (d.worked is string && d.worked.size() <= 500))
            && (!('didNotWork' in d) || (d.didNotWork is string && d.didNotWork.size() <= 500))
            // What the team stated on its sheet: a record for people; the engine never reads it.
            && (!('coverageStatedPct' in d) || (d.coverageStatedPct is int && d.coverageStatedPct >= 0 && d.coverageStatedPct <= 100))
            && (!('clues' in d) || (d.clues is string && d.clues.size() <= 500))
            && (!('hazards' in d) || (d.hazards is string && d.hazards.size() <= 500))
            && (!('clearedEventId' in d) || d.clearedEventId == null
                || (d.clearedEventId is string && d.clearedEventId.matches('^[0-9a-f]{32}$')));
        }
        function clearedBySelf(d) {
          let e = get(/databases/$(database)/documents/incidents/$(incidentId)/events/$(d.clearedEventId)).data;
          return e.type == 'cleared' && e.deviceId == request.auth.uid && e.effect.kind == 'cleared' && e.effect.segmentId == segmentId;
        }
        allow read: if isMember(incidentId);
        allow create: if isMember(incidentId) && debriefOk(request.resource.data)
          && request.resource.data.byUid == request.auth.uid && request.resource.data.createdAt == request.time
          && (isCommand(incidentId) || (request.resource.data.get('clearedEventId', null) is string && clearedBySelf(request.resource.data)));
        allow update: if isCommand(incidentId) && debriefOk(request.resource.data)
          && request.resource.data.byUid == resource.data.byUid && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('clearedEventId', null) == resource.data.get('clearedEventId', null);
        allow delete: if false;
      }

      // Who command removed (removeMember, admin only): command reads them; no client writes one.
      match /removed/{uid} {
        allow read: if isCommand(incidentId);
        allow write: if false;
      }
      // Who joined, with what role and team (joinIncident, admin only): what removal decides from. Command reads them.
      match /members/{uid} {
        allow read: if isCommand(incidentId);
        allow write: if false;
      }

      match /teams/{teamId} {
        allow read: if isMember(incidentId);
        // Teams come only from admin tools (the seed, at most 10, and the practice copy of it): a plan holds at most
        // 10 assignments, one a team, so a client-made 11th team could never be planned for.
        allow write: if false;

        // A device doc's id is its own auth uid, under its own team.
        function ownDevice(deviceId) {
          return isMember(incidentId) && deviceId == request.auth.uid && request.auth.token.team == teamId;
        }

        match /devices/{deviceId} {
          allow read: if isMember(incidentId);
          allow create, update: if ownDevice(deviceId);
          allow delete: if false;

          match /measurements/{eventId} {
            allow read: if isMember(incidentId);
            allow create, update: if ownDevice(deviceId);
            allow delete: if false;
          }
        }
      }

      // profile/shared is readable by every member and carried in packs;
      // profile/command (history, places, vehicle) is command and family only.
      match /profile/shared {
        allow read: if isMember(incidentId);
        allow write: if isCommandOrFamily(incidentId) && validSharedProfile(request.resource.data);
      }
      match /profile/command {
        allow read: if isCommandOrFamily(incidentId);
        allow write: if isCommandOrFamily(incidentId)
          && request.resource.data.keys().hasOnly(['previousAddresses', 'placesFrequented', 'pastWandering',
                                                   'nearbyWater', 'vehicle']);
      }

      // Written by Cloud Functions only.
      // A pack record is read by command and by its own team only.
      match /packs/{teamId} {
        allow read: if isCommand(incidentId) || (isMember(incidentId) && request.auth.token.team == teamId);
        allow write: if false;
      }

      // An approved plan is written once by the command user who approved it.
      match /plans/{version} {
        allow read: if isMember(incidentId);
        allow create: if isCommand(incidentId) && isOpen(incidentId)
          && version.matches('^([0-9]{4}|[1-9][0-9]{4,8})$') && validPlan(request.resource.data, int(version));
        allow update, delete: if false;
      }

      // A clip reading is created BEFORE the upload and the model call, carrying the consent record and no
      // reading (ruling I9); only the record's current owner adds the reading, once, leaving the consents untouched.
      match /clipReadings/{sha256} {
        allow read: if isMember(incidentId);
        allow create: if isCommandOrFamily(incidentId) && validNewClipReading(incidentId, sha256, request.resource.data);
        // The reading is a valid sighting or a typed no-sighting result (a could-not-read result completes the
        // record, so it is cached), with a valid route. While no reading exists, any command or family member
        // takes the record over with their own consent and expiry (the creator renewing is the same case), so a
        // stalled record never blocks a second seat or a new sign-in; the clip's path never changes.
        allow update: if isCommandOrFamily(incidentId)
          && resource.data.reading == null
          && ((resource.data.createdByUid == request.auth.uid
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reading', 'route'])
               && (schema_CameraSighting(request.resource.data.reading) || schema_ClipNoSighting(request.resource.data.reading))
               && schema_RouteRecord(request.resource.data.route))
              || (request.resource.data.createdByUid == request.auth.uid
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consent', 'expiresAt', 'createdAt', 'createdByUid'])
                  && clipConsentOk(request.resource.data)));
        allow delete: if isCommand(incidentId);
      }
      // A question from command to the family, answered once by a family member. Every member reads it; nobody
      // deletes it (incident cleanup does). The push about it carries ids only, never the text.
      match /familyQuestions/{questionId} {
        allow read: if isMember(incidentId);
        // The id is a Firestore auto-id (20 letters and digits), so nothing a person types can ride the push as an
        // id; and only an open incident (not a found or closed one) takes a new question.
        allow create: if isCommand(incidentId) && incidentData(incidentId).status == 'open' && questionId.matches('^[A-Za-z0-9]{20}$')
          && exactKeys(request.resource.data, ['text', 'createdByUid', 'createdAt'])
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 280
          && request.resource.data.createdByUid == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update: if isFamily(incidentId) && !('answer' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'answeredByUid', 'answeredAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasAll(['answer', 'answeredByUid', 'answeredAt'])
          && request.resource.data.answer is string && request.resource.data.answer.size() >= 1 && request.resource.data.answer.size() <= 500
          && request.resource.data.answeredByUid == request.auth.uid && request.resource.data.answeredAt == request.time;
        allow delete: if false;
      }

      match /photoReadings/{sha256} {
        allow read, write: if isCommand(incidentId);
      }
      // A photo's cloud-read consent, written by the family member who shares the photo. Command reads it from the
      // server before any cloud read of that photo. Never changed; its creator withdraws it; the media delete
      // removes it with the photos.
      match /photoConsents/{sha256} {
        allow read: if isCommandOrFamily(incidentId);
        allow create: if isFamily(incidentId) && sha256.matches('^[0-9a-f]{64}$')
          && exactKeys(request.resource.data, ['storagePath', 'cloudProcessing', 'createdByUid', 'createdAt'])
          && request.resource.data.storagePath == 'photos/' + incidentId + '/' + sha256 + '.jpg'
          && consentOk(request.resource.data.cloudProcessing)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isFamily(incidentId) && resource.data.createdByUid == request.auth.uid;
      }

      match /events/{eventId} {
        allow read: if isMember(incidentId);
        allow create: if validEvent(incidentId, eventId);
        allow update, delete: if false;
      }
    }

    // profile/shared is readable by every member and carried in packs, so it takes only the "shared with
    // searchers" fields of spec section 13.2: a field-mapping slip cannot put private history there.
    function validSharedProfile(p) {
      return schema_SharedProfile(p)
        // With the other-names list, nickname mirrors its first name ("" for an empty list), so every reader shows
        // the same name. A profile saved before the list keeps any nickname.
        && (!('otherNames' in p) || (p.otherNames.size() == 0 && p.nickname == '')
            || (p.otherNames.size() > 0 && p.nickname == p.otherNames[0]))
        // Tracking aids: each choice once, and a note with no digit of any script (\P{Nd}), so no serial or phone
        // number reaches a card; the schema's own check above covers ASCII digits and the fixed choices.
        && (!('trackingAids' in p) || (p.trackingAids.aids.toSet().size() == p.trackingAids.aids.size()
            && p.trackingAids.note.matches('^\\P{Nd}{0,80}$')));
    }

    // BEGIN GENERATED by tools/rules/gen_rules_validators.py from shared/schemas. Do not edit by hand.
    function schema_Position(m) {
      return m is map
        && m.size() == 3
        && (m.lat is number && m.lat * m.lat <= 8100)
        && (m.lon is number && m.lon * m.lon <= 32400)
        && (m.accuracyM == null || (m.accuracyM is number && m.accuracyM >= 0));
    }

    // Event-carried shapes (shape mode): numeric ranges, per-item checks and the kind enum as in the schema;
    // other string enums bounded by length, and all-required key sets pinned by size, to stay under the
    // 1,000-expression limit per request.
    function schema_ReportReading(m) {
      return m is map
        && m.size() == 17
        && (m.kind in ['cleared', 'sighting', 'clue', 'found', 'unclear'])
        && (m.segmentIds is list && m.segmentIds.size() <= 3 && m.segmentIds.concat(['x', 'x', 'x'])[0].matches('(?s)^.{1,16}$') && m.segmentIds.concat(['x', 'x', 'x'])[1].matches('(?s)^.{1,16}$') && m.segmentIds.concat(['x', 'x', 'x'])[2].matches('(?s)^.{1,16}$'))
        && (m.method.matches('(?s)^.{0,7}$'))
        && (m.coverage == null || (m.coverage is number))
        && (m.minutes == null || (m.minutes is number))
        && (m.searchers == null || (m.searchers is number))
        && (m.searchType.matches('(?s)^.{0,7}$'))
        && (m.detectionRangeM == null || (m.detectionRangeM is number))
        && (m.item.matches('(?s)^.{0,40}$'))
        && (m.feature.matches('(?s)^.{0,17}$'))
        && (m.direction.matches('(?s)^.{0,10}$'))
        && (m.topColor.matches('(?s)^.{0,7}$'))
        && (m.bottomColor.matches('(?s)^.{0,7}$'))
        && (m.footwear.matches('(?s)^.{0,40}$'))
        && (m.carried.matches('(?s)^.{0,40}$'))
        && (m.matchesProfile.matches('(?s)^.{0,12}$'))
        && (m.evidenceQuote.matches('(?s)^.{0,400}$'));
    }

    function schema_RouteRecord(m) {
      return m is map
        && m.size() == 9
        && (m.platform.matches('(?s)^.{0,7}$'))
        && (m.path.matches('(?s)^.{0,9}$'))
        && (m.stage.matches('(?s)^.{0,20}$'))
        && (m.model.matches('(?s)^.{0,80}$'))
        && (m.reason.matches('(?s)^.{0,26}$'))
        && (m.latencyMs is number && m.latencyMs >= 0)
        && (m.sdkReported is bool)
        && (m.blocked == null || (m.blocked.matches('(?s)^.{0,9}$')))
        && (m.decidedAtMs is number);
    }

    function schema_CameraSighting(m) {
      return m is map
        && m.size() == 15
        && (m.personVisible is bool)
        && (m.firstSeen.matches('^[0-9]{2}:[0-5][0-9]$'))
        && (m.lastSeen.matches('^[0-9]{2}:[0-5][0-9]$'))
        && (m.entryEdge.matches('(?s)^.{0,16}$'))
        && (m.exitEdge.matches('(?s)^.{0,16}$'))
        && (m.topColor.matches('(?s)^.{0,7}$'))
        && (m.bottomColor.matches('(?s)^.{0,7}$'))
        && (m.topType.matches('(?s)^.{0,40}$'))
        && (m.footwear.matches('(?s)^.{0,40}$'))
        && (m.headwear.matches('(?s)^.{0,40}$'))
        && (m.carriedItems is list && m.carriedItems.size() <= 3 && m.carriedItems.concat(['', '', ''])[0].matches('(?s)^.{0,40}$') && m.carriedItems.concat(['', '', ''])[1].matches('(?s)^.{0,40}$') && m.carriedItems.concat(['', '', ''])[2].matches('(?s)^.{0,40}$'))
        && (m.keyFrame is map && m.keyFrame.size() == 2 && (m.keyFrame.time.matches('^[0-9]{2}:[0-5][0-9]$')) && (m.keyFrame.box2d is list && m.keyFrame.box2d.size() == 4 && (m.keyFrame.box2d[0] is int && m.keyFrame.box2d[0] >= 0 && m.keyFrame.box2d[0] <= 1000) && (m.keyFrame.box2d[1] is int && m.keyFrame.box2d[1] >= 0 && m.keyFrame.box2d[1] <= 1000) && (m.keyFrame.box2d[2] is int && m.keyFrame.box2d[2] >= 0 && m.keyFrame.box2d[2] <= 1000) && (m.keyFrame.box2d[3] is int && m.keyFrame.box2d[3] >= 0 && m.keyFrame.box2d[3] <= 1000)))
        && (m.lighting.matches('(?s)^.{0,9}$'))
        && (m.legibility.matches('(?s)^.{0,7}$'))
        && (m.evidence.matches('(?s)^.{0,400}$'));
    }

    function schema_CameraSightingReading(m) {
      return m is map
        && m.size() == 5
        && schema_CameraSighting(m.sighting)
        && (m.clipSha256.matches('^[0-9a-f]{64}$'))
        && (m.clipStartMs is number)
        && (m.clockConfirmed is bool)
        && (m.cameraFacingDeg == null || (m.cameraFacingDeg is int && m.cameraFacingDeg >= 0 && m.cameraFacingDeg <= 315 && m.cameraFacingDeg % 45 == 0));
    }

    function schema_IncidentConditions(m) {
      return m is map
        && m.keys().hasOnly(['tempF', 'wet', 'setAtMs'])
        && m.size() == 3
        && (m.tempF == null || (m.tempF is number && m.tempF >= -80 && m.tempF <= 140))
        && (m.wet == null || (m.wet is bool))
        && (m.setAtMs is number && m.setAtMs >= 0);
    }

    function schema_ClipNoSighting(m) {
      return m is map
        && m.keys().hasOnly(['status', 'reasons'])
        && m.size() == 2
        && (m.status in ['no_sighting'])
        && (m.reasons is list && m.reasons.size() <= 11 && m.reasons.hasOnly(['no_person', 'first_seen_format', 'last_seen_format', 'key_frame_format', 'first_after_last', 'last_after_clip_end', 'first_after_clip_end', 'key_frame_after_clip_end', 'box', 'unreadable_reply', 'model_error']) && m.reasons.size() >= 1);
    }

    // A content report's createdAt is the server's time of the write.
    function schema_ContentReport(m) {
      return m is map
        && m.keys().hasOnly(['authorUid', 'role', 'target', 'targetId', 'reason', 'note', 'createdAt'])
        && m.keys().hasAll(['authorUid', 'role', 'target', 'targetId', 'reason', 'createdAt'])
        && (m.authorUid is string && m.authorUid.size() >= 1 && m.authorUid.size() <= 128)
        && (m.role in ['searcher', 'family'])
        && (m.target in ['task', 'family_description', 'event'])
        && (m.targetId == null || (m.targetId.matches('^[A-Za-z0-9_-]{1,64}$')))
        && (m.reason in ['abusive', 'personal_information', 'wrong_or_misleading', 'other'])
        && (!('note' in m) || (m.note is string && m.note.size() <= 500))
        && m.createdAt == request.time;
    }

    // profile/shared is always written whole (all 20 keys), so every reader can rely on every field.
    function schema_SharedProfile(m) {
      return m is map
        && m.keys().hasOnly(['answersTo', 'nickname', 'otherNames', 'ageYears', 'gender', 'appearance', 'heightFt', 'heightIn', 'weightLb', 'hair', 'eyeColor', 'primaryLanguage', 'clothingLastWorn', 'mobilityAids', 'dementiaType', 'flags', 'triggersToAvoid', 'bestApproach', 'uniqueDescription', 'photoTakenOn', 'approachNoteIds', 'trackingAids'])
        && m.keys().hasAll(['answersTo', 'nickname', 'ageYears', 'gender', 'appearance', 'heightFt', 'heightIn', 'weightLb', 'hair', 'eyeColor', 'primaryLanguage', 'clothingLastWorn', 'mobilityAids', 'dementiaType', 'flags', 'triggersToAvoid', 'bestApproach', 'uniqueDescription', 'photoTakenOn', 'approachNoteIds'])
        && (m.answersTo is string && m.answersTo.size() <= 60)
        && (m.nickname is string && m.nickname.size() <= 60)
        && (!('otherNames' in m) || (m.otherNames is list && m.otherNames.size() <= 5 && (m.otherNames.size() < 1 || (m.otherNames[0] is string && m.otherNames[0].size() >= 1 && m.otherNames[0].size() <= 60)) && (m.otherNames.size() < 2 || (m.otherNames[1] is string && m.otherNames[1].size() >= 1 && m.otherNames[1].size() <= 60)) && (m.otherNames.size() < 3 || (m.otherNames[2] is string && m.otherNames[2].size() >= 1 && m.otherNames[2].size() <= 60)) && (m.otherNames.size() < 4 || (m.otherNames[3] is string && m.otherNames[3].size() >= 1 && m.otherNames[3].size() <= 60)) && (m.otherNames.size() < 5 || (m.otherNames[4] is string && m.otherNames[4].size() >= 1 && m.otherNames[4].size() <= 60))))
        && (m.ageYears == null || (m.ageYears is int && m.ageYears >= 18 && m.ageYears <= 120))
        && (m.gender is string && m.gender.size() <= 40)
        && (m.appearance is string && m.appearance.size() <= 200)
        && (m.heightFt == null || (m.heightFt is int && m.heightFt >= 3 && m.heightFt <= 8))
        && (m.heightIn == null || (m.heightIn is int && m.heightIn >= 0 && m.heightIn <= 11))
        && (m.weightLb == null || (m.weightLb is int && m.weightLb >= 50 && m.weightLb <= 500))
        && (m.hair is string && m.hair.size() <= 60)
        && (m.eyeColor is string && m.eyeColor.size() <= 40)
        && (m.primaryLanguage is string && m.primaryLanguage.size() <= 40)
        && (m.clothingLastWorn is string && m.clothingLastWorn.size() <= 200)
        && (m.mobilityAids is list && m.mobilityAids.size() <= 4 && m.mobilityAids.hasOnly(['cane', 'walker', 'wheelchair', 'other']))
        && (m.dementiaType == null || (m.dementiaType in ['alzheimers', 'lewy_body', 'vascular', 'frontotemporal', 'mixed', 'other', 'unknown']))
        && (m.flags is map && m.flags.keys().hasOnly(['mayNotRespond', 'likelyToHide', 'afraidOfUniforms', 'sensitiveToTouch', 'sensitiveToLight', 'likelyToFight', 'seizures', 'hallucinationsOrDelusions', 'lookingForHome', 'gaitUnsteady', 'freezing', 'fallRisk', 'softVoice', 'slowToRespond', 'fluctuates', 'medicationSensitivity', 'carriesMedicalAlertCard', 'medicationTimingMatters']) && m.flags.size() == 18 && (m.flags.mayNotRespond is bool) && (m.flags.likelyToHide is bool) && (m.flags.afraidOfUniforms is bool) && (m.flags.sensitiveToTouch is bool) && (m.flags.sensitiveToLight is bool) && (m.flags.likelyToFight is bool) && (m.flags.seizures is bool) && (m.flags.hallucinationsOrDelusions is bool) && (m.flags.lookingForHome is bool) && (m.flags.gaitUnsteady is bool) && (m.flags.freezing is bool) && (m.flags.fallRisk is bool) && (m.flags.softVoice is bool) && (m.flags.slowToRespond is bool) && (m.flags.fluctuates is bool) && (m.flags.medicationSensitivity is bool) && (m.flags.carriesMedicalAlertCard is bool) && (m.flags.medicationTimingMatters is bool))
        && (m.triggersToAvoid is string && m.triggersToAvoid.size() <= 200)
        && (m.bestApproach is string && m.bestApproach.size() <= 200)
        && (m.uniqueDescription is string && m.uniqueDescription.size() <= 200)
        && (m.photoTakenOn == null || (m.photoTakenOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (m.approachNoteIds is list && m.approachNoteIds.size() <= 22 && m.approachNoteIds.hasOnly(['may_not_respond', 'approach_calm', 'stop_calling_name', 'likely_to_hide', 'afraid_of_uniforms', 'validate_feelings', 'looking_for_home', 'gait_unsteady', 'freezing', 'fall_risk', 'soft_voice', 'fluctuates', 'sensitive_to_touch', 'sensitive_to_light', 'may_strike_out', 'seizures', 'medication_alert', 'medication_timing', 'language', 'triggers', 'best_approach', 'unique']))
        && (!('trackingAids' in m) || (m.trackingAids is map && m.trackingAids.keys().hasOnly(['aids', 'note']) && m.trackingAids.size() == 2 && (m.trackingAids.aids is list && m.trackingAids.aids.size() <= 4 && m.trackingAids.aids.hasOnly(['project_lifesaver', 'medicalert_id', 'gps_tracker', 'phone_location'])) && (m.trackingAids.note.size() <= 80 && m.trackingAids.note.matches('^[^0-9]{0,80}$'))));
    }
    // END GENERATED

    function consentOk(c) {
      return c is map && exactKeys(c, ['byUid', 'atMs']) && c.byUid == request.auth.uid && c.atMs is number;
    }
    function validNewClipReading(incidentId, sha, d) {
      return sha.matches('^[0-9a-f]{64}$')
        && exactKeys(d, ['sha256', 'storagePath', 'durationS', 'clipStartMs', 'clockConfirmed', 'cameraFacingDeg',
                         'reading', 'route', 'consent', 'expiresAt', 'createdAt', 'createdByUid'])
        && d.sha256 == sha
        && d.storagePath == 'clips/' + incidentId + '/' + sha + '.mp4'
        && d.createdByUid == request.auth.uid
        && d.reading == null && d.route == null
        && clipConsentOk(d)
        && (d.durationS == null || d.durationS is number)
        && d.clipStartMs is number && d.clockConfirmed is bool
        && (d.cameraFacingDeg == null || d.cameraFacingDeg in [0, 45, 90, 135, 180, 225, 270, 315]);
    }
    // The three required consents by the writer, an expiry 31 to 33 days out at the server's time (clients write
    // 32, which tolerates clock skew both ways) and a server createdAt. Storage takes the clip only while this
    // expiry is at least 31 days after the upload, and deletes the clip 30 days after upload, so the consent's
    // TTL never runs before the clip it covers is gone.
    function clipConsentOk(d) {
      return d.consent is map && exactKeys(d.consent, ['personInClip', 'footageOwner', 'cloudProcessing', 'publicUse'])
        && consentOk(d.consent.personInClip) && consentOk(d.consent.footageOwner) && consentOk(d.consent.cloudProcessing)
        && (d.consent.publicUse == null || consentOk(d.consent.publicUse))
        && d.expiresAt is timestamp && d.expiresAt >= request.time + duration.value(31, 'd') && d.expiresAt <= request.time + duration.value(33, 'd')
        && d.createdAt == request.time;
    }

    function typeAllowed(type, r) {
      return r == 'command' && type in ['cleared', 'clue', 'sighting', 'camera_sighting', 'destination',
                                        'confirmation', 'retraction', 'found', 'plan_ack']
        || r == 'searcher' && type in ['cleared', 'clue', 'sighting', 'found', 'plan_ack', 'retraction']
        || r == 'family' && type in ['sighting', 'camera_sighting', 'destination', 'confirmation', 'retraction'];
    }

    // A retraction targets an event that exists; only command may retract another author's event.
    function retractionOk(incidentId, d) {
      let targetPath = /databases/$(database)/documents/incidents/$(incidentId)/events/$(d.targetEventId);
      return d.targetEventId is string
        && exists(targetPath)
        && (role() == 'command' || get(targetPath).data.authorUid == request.auth.uid);
    }

    // The stored effect is applied by every device without re-deriving it, so each variant is
    // checked here (spec section 8): a malformed effect must never reach another device's engine.
    // Key sets are pinned by size: every check reads each named key, a missing key is an error and an
    // error denies, so size() == n admits exactly those keys without list literals (the 1,000-expression
    // limit; functions/test/rules/shapes.test.ts drops each key in turn to prove it).
    // plan.schema.json, checked as it is written: the doc id is the version zero-padded to at least 4 digits, and
    // approvedAt is the server's time, and the id is that exact form ("0016", never "00016"). Rules cannot loop, so each
    // of the at most 8 assignments (one a team; a drill has at most 8 teams) is checked by index. The worst case, a judge
    // incident with a blocked wording route and every text and id at its longest, fits 9 under the 1,000-expression
    // limit and not 10 (measured in the emulator), so 8 keeps one assignment of room.
    function validPlan(p, version) {
      return exactKeys(p, ['version', 'basedOnEventSetHash', 'priorVersion', 'assignments', 'wordingRoute',
          'approvedByUid', 'approvedAt', 'createdClientTimeMs'])
        && p.version is int && p.version >= 1 && p.version == version
        && p.basedOnEventSetHash is string && p.basedOnEventSetHash.matches('^[0-9a-f]{64}$')
        && p.priorVersion is int && p.priorVersion >= 0
        && (p.wordingRoute == null || schema_RouteRecord(p.wordingRoute))
        && p.approvedByUid == request.auth.uid && p.approvedAt == request.time
        && p.createdClientTimeMs is number && p.createdClientTimeMs >= 0
        && validAssignments(p.assignments);
    }
    function validAssignments(l) {
      return l is list && l.size() <= 8
        && (l.size() < 1 || validAssignment(l[0]))
        && (l.size() < 2 || validAssignment(l[1]))
        && (l.size() < 3 || validAssignment(l[2]))
        && (l.size() < 4 || validAssignment(l[3]))
        && (l.size() < 5 || validAssignment(l[4]))
        && (l.size() < 6 || validAssignment(l[5]))
        && (l.size() < 7 || validAssignment(l[6]))
        && (l.size() < 8 || validAssignment(l[7]));
    }
    // A team id a push can reach (as joinIncident requires), at most 6 segment ids of grid form, and bounded texts.
    // Written for few rules expressions (8 of these must fit the 1,000-expression limit). An error denies, so:
    // hasOnly() plus reading each of the four fields admits exactly those keys (a missing one errors); keys() and
    // matches() error on a wrong type; join() errors on a non-list, its pattern allows at most 6 ids, and a non-empty
    // list must join to at least one id, which refuses a list of one empty id. join() turns a number into text, so
    // splitting the joined ids must give back the same list: that refuses a number and an id holding a comma.
    function validAssignment(a) {
      return a.keys().hasOnly(['teamId', 'segmentIds', 'taskText', 'reason'])
        && a.teamId.matches('^[A-Za-z0-9_]{1,32}$')
        && a.segmentIds is list
        && (a.segmentIds.size() == 0 || a.segmentIds.join(',').matches('^[A-Za-z0-9_]{1,16}(,[A-Za-z0-9_]{1,16}){0,5}$'))
        && (a.segmentIds.size() == 0 || a.segmentIds.join(',').split(',') == a.segmentIds)
        && a.taskText.matches('(?s)^.{0,200}$') && a.reason.matches('(?s)^.{0,200}$');
    }
    function exactKeys(m, keys) {
      return m.keys().hasOnly(keys) && m.keys().hasAll(keys);
    }
    function optionalLength(v) {
      return v == null || (v is number && v >= 0);
    }
    function validClearedInputs(i) {
      return i is map
        && i.size() == 5
        && i.coverage is number && i.coverage >= 0
        && optionalLength(i.sweepWidthM)
        && optionalLength(i.trackLengthM)
        && i.areaM2 is number && i.areaM2 > 0
        && i.rdBasis in ['hidden_target', 'open_target', 'default', 'stated'];
    }
    function validEffect(e) {
      return e is map && (
        (e.kind == 'cleared'
          && e.size() == 4
          && e.segmentId is string && e.segmentId.size() >= 1 && e.segmentId.size() <= 16
          && e.pod is number && e.pod >= 0 && e.pod <= 1
          && validClearedInputs(e.inputs))
        || (e.kind == 'clue'
          && e.size() == 3
          && e.influences is map && e.influences.size() >= 1 && e.influences.size() <= 64
          && e.influences.values().hasOnly(['strong_for', 'for', 'neutral', 'against', 'strong_against'])
          && e.authenticity in ['high', 'medium', 'low'])
        || (e.kind == 'none'
          && e.size() == 2
          && e.why in ['needs_command', 'informational', 'invalid', 'sound_only', 'outside_area', 'incorporated_in_prior']));
    }

    // eventId = first 32 lowercase hex of SHA-256 over, per field (incidentId, deviceId, decimal seq), the
    // decimal UTF-8 byte length, ":" and the value. Recomputing it binds the id to the writer, so nobody can
    // occupy another device's future id (create-only would then block the real event).
    function frame(s) {
      return string(s.toUtf8().size()) + ':' + s;
    }
    function eventIdOf(incidentId, deviceId, seq) {
      return hashing.sha256(frame(incidentId) + frame(deviceId) + frame(string(seq))).toHexString().lower();
    }

    // A camera sighting carries its clip reference (ruling I10): the model's sighting, the clip's SHA-256,
    // its start time, whether the family confirmed the camera clock, and an 8-way facing or null. The clip
    // reading doc (consent record) must exist.
    function cameraMovesPrior(incidentId, eventId, inc) {
      let after = getAfter(/databases/$(database)/documents/incidents/$(incidentId)).data;
      let inputs = after.get('priorInputEventIds', []);
      // A list only: `in` also matches the keys of a map.
      return after.get('priorVersion', -1) == inc.get('priorVersion', 0) + 1 && inputs is list && eventId in inputs;
    }

    function cameraReadingOk(incidentId, r) {
      return schema_CameraSightingReading(r)
        && exists(/databases/$(database)/documents/incidents/$(incidentId)/clipReadings/$(r.clipSha256));
    }

    function validEvent(incidentId, eventId) {
      let d = request.resource.data;
      // The role claim, read once: the 1,000-expression budget is tight for the largest events.
      // d.size() == 25 pins the key set because each of the 25 event.schema.json fields is read below
      // (shapes.test.ts drops each in turn with a stray key in its place and must be refused).
      let r = request.auth.token.role;
      let inc = incidentData(incidentId);
      let t = d.type;
      // Membership and openness from one read of the incident (same checks as isMember and isOpen).
      // No signedIn() here: reading a claim without auth is an error, and an error denies.
      return request.auth.token.inc == incidentId && liveFor(inc) && !isRemoved(incidentId)
        && inc.status != 'closed'
        && eventId.matches('^[0-9a-f]{32}$')
        && d.size() == 25
        && d.eventId == eventId
        && d.schemaVersion == 1
        && d.incidentId == incidentId
        && d.authorUid == request.auth.uid
        && d.role == r
        && d.serverTime == request.time
        && d.seq is int && d.seq >= 0
        && d.clientTimeMs is number
        && d.deviceId == request.auth.uid
        && eventIdOf(incidentId, request.auth.uid, d.seq).matches(eventId + '[0-9a-f]{32}')
        && (d.teamId == null || (d.teamId is string && d.teamId.size() <= 32))
        && (r != 'searcher' || d.teamId == request.auth.token.team)
        && d.reporter in ['searcher', 'public_caller', 'family', 'camera', 'system']
        && d.positionSource in ['gps', 'assigned_segment', 'manual', 'map_click', 'camera_pin', 'none']
        && d.inputMethod in ['keyboard_dictation', 'typed', 'picklist', 'clip', 'photo', 'system']
        && d.isTrainingInject is bool
        && d.priorVersion is int
        && (d.planVersion == null || d.planVersion is int)
        && (d.observedAtMs == null || d.observedAtMs is number)
        && (d.position == null || schema_Position(d.position))
        && (d.rawText == null || (d.rawText is string && d.rawText.size() <= 2000))
        && (t == 'camera_sighting' || d.reading == null || schema_ReportReading(d.reading))
        && (d.route == null || schema_RouteRecord(d.route))
        && validEffect(d.effect)
        // A cleared effect belongs to a cleared event only (the engine counts it on no other type).
        && (d.effect.kind != 'cleared' || t == 'cleared')
        && (d.targetEventId == null || d.targetEventId.matches('^[0-9a-f]{32}$'))
        && (d.decision == null || d.decision in ['confirmed', 'rejected'])
        && typeAllowed(t, r)
        && (t != 'retraction' || retractionOk(incidentId, d))
        && (t != 'camera_sighting' || cameraReadingOk(incidentId, d.reading))
        // Command adds a camera sighting only in the batch that moves the prior to the next version with it as an input.
        && (t != 'camera_sighting' || r != 'command' || cameraMovesPrior(incidentId, eventId, inc))
        // targetEventId and decision are validated above; a confirmation only has to carry both.
        && (t != 'confirmation' || (d.targetEventId != null && d.decision != null));
    }
  }
}
