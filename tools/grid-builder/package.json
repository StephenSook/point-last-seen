{
  "name": "@pls/grid-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Builds the drill-site grid (125 m cells, OSM features, stream direction). Output data is ODbL.",
  "scripts": {
