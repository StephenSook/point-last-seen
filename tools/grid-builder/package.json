    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build-grid": "tsx src/cli.ts"
  },
  "dependencies": {
    "@pls/engine": "0.1.0",
    "@turf/along": "7.4.0",
    "@turf/area": "7.4.0",
    "@turf/bbox": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/centroid": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/intersect": "7.4.0",
    "@turf/length": "7.4.0",
    "@turf/point-to-line-distance": "7.4.0",
    "@turf/polygon-to-line": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
