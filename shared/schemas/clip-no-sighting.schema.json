{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pointlastseen.app/schemas/clip-no-sighting.schema.json",
  "title": "ClipNoSighting",
  "description": "A clip reading that found no usable sighting, stored as the clip reading's `reading` so the record is complete and cached: the reasons are the shared camera check's codes (shared/engine-ts/src/camera.ts checkSighting) plus a reply that could not be parsed and a model error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reasons"
  ],
  "properties": {
    "status": {
      "enum": [
        "no_sighting"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "items": {
        "enum": [
          "no_person",
          "first_seen_format",
          "last_seen_format",
          "key_frame_format",
          "first_after_last",
          "last_after_clip_end",
          "first_after_clip_end",
          "key_frame_after_clip_end",
          "box",
          "unreadable_reply",
          "model_error"
        ]
      }
    }
  },
  "x-parity": {
    "#": {
      "ts": "shared/engine-ts/src/types.ts#ClipNoSighting",
      "android": "pending:android/app/src/main/java/app/pointlastseen/family/ai/ClipNoSighting.kt#ClipNoSighting"
    }
  }
}
