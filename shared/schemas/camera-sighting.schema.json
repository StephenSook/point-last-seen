{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pointlastseen.app/schemas/camera-sighting.schema.json",
  "title": "CameraSighting",
  "description": "Structured read of one staged doorbell or home clip (spec section 12.1). Code derives the bearing and forces colors to unknown at night.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "personVisible",
    "firstSeen",
    "lastSeen",
    "entryEdge",
    "exitEdge",
    "topColor",
    "bottomColor",
    "topType",
    "footwear",
    "headwear",
    "carriedItems",
    "keyFrame",
    "lighting",
    "legibility",
    "evidence"
  ],
  "properties": {
    "personVisible": {
      "type": "boolean"
    },
    "firstSeen": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-5][0-9]$"
    },
    "lastSeen": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-5][0-9]$"
    },
    "entryEdge": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "toward_camera",
        "away_from_camera",
        "unknown"
      ]
    },
    "exitEdge": {
      "enum": [
        "left",
        "right",
        "top",
        "bottom",
        "toward_camera",
        "away_from_camera",
        "unknown"
      ]
    },
    "topColor": {
      "enum": [
        "black",
        "white",
        "gray",
        "brown",
        "tan",
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple",
        "pink",
        "unknown"
      ]
    },
    "bottomColor": {
      "enum": [
        "black",
        "white",
        "gray",
        "brown",
        "tan",
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "purple",
        "pink",
        "unknown"
      ]
    },
    "topType": {
      "type": "string",
      "maxLength": 40
    },
    "footwear": {
      "type": "string",
      "maxLength": 40
    },
    "headwear": {
      "type": "string",
      "maxLength": 40
    },
    "carriedItems": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "maxItems": 3
    },
    "keyFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "box2d"
      ],
      "properties": {
        "time": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-5][0-9]$"
        },
        "box2d": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[yMin, xMin, yMax, xMax], 0 to 1000"
        }
      }
    },
    "lighting": {
      "enum": [
        "day",
        "night_ir",
        "low_light",
        "unknown"
      ]
    },
    "legibility": {
      "enum": [
        "clear",
        "partial",
        "poor"
      ]
    },
    "evidence": {
      "type": "string",
      "maxLength": 400
    }
  },
  "x-parity": {
    "#": {
      "ts": "shared/engine-ts/src/types.ts#CameraSighting",
      "android": "android/app/src/main/java/app/pointlastseen/family/core/CameraSighting.kt#CameraSighting"
    }
  }
}
