{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pointlastseen.app/schemas/subject-profile.schema.json",
  "title": "SubjectProfile",
  "description": "The two Firestore profile documents (spec section 13.2). Health and behaviour fields never reach a model prompt or tool output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shared",
    "command"
  ],
  "properties": {
    "shared": {
      "$ref": "#/$defs/SharedProfile"
    },
    "command": {
      "$ref": "#/$defs/CommandProfile"
    }
  },
  "$defs": {
    "SharedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answersTo",
        "nickname",
        "ageYears",
        "gender",
        "appearance",
        "heightFt",
        "heightIn",
        "weightLb",
        "hair",
        "eyeColor",
        "primaryLanguage",
        "clothingLastWorn",
        "mobilityAids",
        "dementiaType",
        "flags",
        "triggersToAvoid",
        "bestApproach",
        "uniqueDescription",
        "photoTakenOn",
        "approachNoteIds"
      ],
      "properties": {
        "answersTo": {
          "type": "string",
          "maxLength": 60
        },
        "nickname": {
          "type": "string",
          "maxLength": 60
        },
        "otherNames": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "description": "Other names she may answer to, in the family's order; nickname mirrors the first.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "ageYears": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 18,
              "maximum": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "gender": {
          "type": "string",
          "maxLength": 40
        },
        "appearance": {
          "type": "string",
          "maxLength": 200
        },
        "heightFt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 3,
              "maximum": 8
            },
            {
              "type": "null"
            }
          ]
        },
        "heightIn": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            },
            {
              "type": "null"
            }
          ]
        },
        "weightLb": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 50,
              "maximum": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "hair": {
          "type": "string",
          "maxLength": 60
        },
        "eyeColor": {
          "type": "string",
          "maxLength": 40
        },
        "primaryLanguage": {
          "type": "string",
          "maxLength": 40
        },
        "clothingLastWorn": {
          "type": "string",
          "maxLength": 200
        },
        "mobilityAids": {
          "type": "array",
          "items": {
            "enum": [
              "cane",
              "walker",
              "wheelchair",
              "other"
            ]
          }
        },
        "dementiaType": {
          "anyOf": [
            {
              "enum": [
                "alzheimers",
                "lewy_body",
                "vascular",
                "frontotemporal",
                "mixed",
                "other",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mayNotRespond",
            "likelyToHide",
            "afraidOfUniforms",
            "sensitiveToTouch",
            "sensitiveToLight",
            "likelyToFight",
            "seizures",
            "hallucinationsOrDelusions",
            "lookingForHome",
            "gaitUnsteady",
            "freezing",
            "fallRisk",
            "softVoice",
            "slowToRespond",
            "fluctuates",
            "medicationSensitivity",
            "carriesMedicalAlertCard",
            "medicationTimingMatters"
          ],
          "properties": {
            "mayNotRespond": {
              "type": "boolean"
            },
            "likelyToHide": {
              "type": "boolean"
            },
            "afraidOfUniforms": {
              "type": "boolean"
            },
            "sensitiveToTouch": {
              "type": "boolean"
            },
            "sensitiveToLight": {
              "type": "boolean"
            },
            "likelyToFight": {
              "type": "boolean"
            },
            "seizures": {
              "type": "boolean"
            },
            "hallucinationsOrDelusions": {
              "type": "boolean"
            },
            "lookingForHome": {
              "type": "boolean"
            },
            "gaitUnsteady": {
              "type": "boolean"
            },
            "freezing": {
              "type": "boolean"
            },
            "fallRisk": {
              "type": "boolean"
            },
            "softVoice": {
              "type": "boolean"
            },
            "slowToRespond": {
              "type": "boolean"
            },
            "fluctuates": {
              "type": "boolean"
            },
            "medicationSensitivity": {
              "type": "boolean"
            },
            "carriesMedicalAlertCard": {
              "type": "boolean"
            },
            "medicationTimingMatters": {
              "type": "boolean"
            }
          }
        },
        "triggersToAvoid": {
          "type": "string",
          "maxLength": 200
        },
        "bestApproach": {
          "type": "string",
          "maxLength": 200
        },
        "uniqueDescription": {
          "type": "string",
          "maxLength": 200
        },
        "photoTakenOn": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "approachNoteIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "trackingAids": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aids",
            "note"
          ],
          "description": "What the family said about tracking aids, for the search cards only and never sent to a model. Absent: unknown. An empty list with an empty note: the family said none.",
          "properties": {
            "aids": {
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "project_lifesaver",
                  "medicalert_id",
                  "gps_tracker",
                  "phone_location"
                ]
              }
            },
            "note": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[^0-9]{0,80}$",
              "description": "Anything else about the device, with no digits, so no serial or phone number reaches a card."
            }
          }
        }
      },
      "description": "profile/shared: readable by every member and carried in the pack. dementiaType is null unless the family switched sharing on."
    },
    "CommandProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previousAddresses",
        "placesFrequented",
        "pastWandering",
        "nearbyWater",
        "vehicle"
      ],
      "properties": {
        "previousAddresses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "position"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              "position": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "lat",
                      "lon"
                    ],
                    "properties": {
                      "lat": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "lon": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "placesFrequented": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "position"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 80,
                "minLength": 1
              },
              "position": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "lat",
                      "lon"
                    ],
                    "properties": {
                      "lat": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "lon": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "pastWandering": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "foundWhere",
              "position"
            ],
            "properties": {
              "foundWhere": {
                "type": "string",
                "maxLength": 120
              },
              "position": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "lat",
                      "lon"
                    ],
                    "properties": {
                      "lat": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "lon": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "nearbyWater": {
          "type": "string",
          "maxLength": 200
        },
        "vehicle": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "involved",
                "description"
              ],
              "properties": {
                "involved": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "maxLength": 120
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "profile/command: command and family roles only; never in a pack."
    }
  },
  "x-parity": {
    "#/$defs/SharedProfile": {
      "ts": "shared/engine-ts/src/types.ts#SharedProfile",
      "ios": "pending:ios/PLSCore/Sources/PLSCore/Profile.swift#SharedProfile",
      "android": "android/app/src/main/java/app/pointlastseen/family/data/Profiles.kt#SharedProfile"
    },
    "#/$defs/CommandProfile": {
      "ts": "shared/engine-ts/src/types.ts#CommandProfile",
      "android": "android/app/src/main/java/app/pointlastseen/family/data/Profiles.kt#CommandProfile"
    }
  }
}
