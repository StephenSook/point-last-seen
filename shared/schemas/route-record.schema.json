{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pointlastseen.app/schemas/route-record.schema.json",
  "title": "RouteRecord",
  "description": "Where one model read ran and why (spec section 9). On iOS it is our own record, never SDK-reported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform",
    "path",
    "stage",
    "model",
    "reason",
    "latencyMs",
    "sdkReported",
    "blocked",
    "decidedAtMs"
  ],
  "properties": {
    "platform": {
      "enum": [
        "ios",
        "web",
        "android"
      ]
    },
    "path": {
      "enum": [
        "on_device",
        "cloud",
        "rules",
        "unknown"
      ]
    },
    "stage": {
      "enum": [
        "guided",
        "permissive_text",
        "deterministic_parser",
        "evidence_protocol",
        "sdk",
        "picklist"
      ]
    },
    "model": {
      "type": "string",
      "maxLength": 80
    },
    "reason": {
      "enum": [
        "on_device_default",
        "no_network",
        "on_device_unavailable",
        "locale_unsupported",
        "over_token_budget",
        "possible_evidence",
        "not_drill_mode",
        "sdk_prefer_in_cloud",
        "sdk_prefer_on_device",
        "sdk_only_in_cloud",
        "sdk_only_on_device",
        "sdk_fallback",
        "link_down_fallback",
        "template_fallback",
        "consented_cloud_read"
      ]
    },
    "latencyMs": {
      "type": "number",
      "minimum": 0
    },
    "sdkReported": {
      "type": "boolean"
    },
    "blocked": {
      "anyOf": [
        {
          "enum": [
            "guardrail",
            "refusal"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "decidedAtMs": {
      "type": "number",
      "minimum": 0
    }
  },
  "x-parity": {
    "#": {
      "ts": "shared/engine-ts/src/types.ts#RouteRecord",
      "ios": "ios/PLSCore/Sources/PLSCore/RouterPolicy.swift#RouteRecord",
      "android": "android/app/src/main/java/app/pointlastseen/family/data/EventDoc.kt#RouteRecord"
    }
  }
}
